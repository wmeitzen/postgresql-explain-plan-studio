[Unit]
Description=PEPS sync from VMware shared folder and rebuild
# Give HGFS a moment after boot before the first rsync.
After=default.target

[Service]
Type=simple
Environment=PEPS_HOST_REPO=/mnt/hgfs/peps
Environment=PEPS_LOCAL_REPO=%h/peps
# Always start from the share so the first boot works even if ~/peps is stale.
# dev-watch.sh: HGFS check → sync to ~/peps → initial package → sync-watch loop.
ExecStartPre=/bin/sleep 15
ExecStart=/bin/bash /mnt/hgfs/peps/scripts/dev-watch.sh
Restart=on-failure
RestartSec=20

[Install]
WantedBy=default.target
